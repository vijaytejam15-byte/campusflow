# ── CampusFlow backend environment variables ──────────────────────────────────
# Copy this to .env and fill in every value marked as required.
# NEVER commit .env to version control.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development          # development | production

# ── Authentication (REQUIRED) ─────────────────────────────────────────────────
# Long random string — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Access token lifetime (default 15m — do not change unless you know why)
JWT_EXPIRES_IN=15m

# Refresh token lifetime (default 30d)
JWT_REFRESH_IN=30d

# ── Database ──────────────────────────────────────────────────────────────────
# Leave empty in development — uses in-memory MongoDB automatically.
# Required in production: mongodb+srv://user:pass@cluster.mongodb.net/CampusFlow
MONGO_URI=

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Email — Gmail SMTP configuration ─────────────────────────────────────────
# Set EMAIL_ENABLED=true to send real emails.
# For Gmail, use an App Password — NOT your normal Gmail password.
#
# Gmail App Password setup (required if using Gmail):
#   1. Enable 2-Step Verification:  https://myaccount.google.com/security
#   2. Go to: Google Account → Security → 2-Step Verification → App passwords
#   3. Select app: "Mail", device: "Other (CampusFlow)"
#   4. Copy the generated 16-character password (no spaces)
#   5. Paste it into EMAIL_PASS below
#
# SECURITY: Never commit real credentials. Keep them only in your .env file.
#
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false            # false = STARTTLS (port 587); true = TLS (port 465)
EMAIL_USER=your@gmail.com     # Your Gmail address
EMAIL_PASS=                   # 16-char Gmail App Password (primary key)
EMAIL_PASSWORD=               # Alias for EMAIL_PASS — EMAIL_PASSWORD takes precedence if both set
EMAIL_FROM=CampusFlow <your@gmail.com>  # Sender display name and address

# ── Redis / BullMQ ────────────────────────────────────────────────────────────
# Set REDIS_ENABLED=true in production when Redis is available.
# When false (default), jobs run in-process synchronously (safe for dev/test).
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# ── Cloud Storage ─────────────────────────────────────────────────────────────
# STORAGE_DRIVER=local   → files saved to UPLOAD_DIR (default, works out of the box)
# STORAGE_DRIVER=s3      → files saved to S3 / MinIO / Cloudflare R2
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
MAX_FILES=5

# S3 credentials (only needed when STORAGE_DRIVER=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=campusflow-uploads
AWS_ENDPOINT=          # optional: MinIO/R2 endpoint URL
STORAGE_SIGNED_URL_TTL=300   # signed URL expiry in seconds

# ── Logging ───────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=debug

# ── Docker / Cloud overrides (set these in docker-compose or cloud env) ───────
# MONGO_USER=campusflow
# MONGO_PASS=changeme
# APP_PORT=80

# ── Rate limiting overrides ────────────────────────────────────────────────────
# AUTH_RATE_LIMIT_MAX: max login attempts per 15-minute window.
# Default: 20 in production, disabled (skipped) when LOCAL_DOCKER=true.
# To manually set a value in production: AUTH_RATE_LIMIT_MAX=20
# AUTH_RATE_LIMIT_MAX=
