# ── CampusFlow — Production environment template ──────────────────────────────
# Copy this to .env on your production server and fill in every value.
# NEVER commit .env with real secrets.
#
# Usage:
#   cp .env.production.example .env
#   nano .env   (fill in your values)
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d

# ── MongoDB ────────────────────────────────────────────────────────────────────
MONGO_USER=campusflow
MONGO_PASS=CHANGE_THIS_STRONG_MONGO_PASSWORD

# ── Authentication ─────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_64_CHAR_RANDOM_SECRET

# ── Public domain (REQUIRED — must match your actual HTTPS domain exactly) ────
# No trailing slash. Must be HTTPS in production.
FRONTEND_URL=https://your-domain.com

# ── Email (Gmail) ──────────────────────────────────────────────────────────────
EMAIL_ENABLED=true
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your@gmail.com
EMAIL_PASS=your-16-char-app-password
EMAIL_FROM=CampusFlow <your@gmail.com>

# ── Storage ────────────────────────────────────────────────────────────────────
STORAGE_DRIVER=local

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Port (only needed if NOT behind a reverse proxy) ──────────────────────────
APP_PORT=80
